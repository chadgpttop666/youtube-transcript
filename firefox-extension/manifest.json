{
  "manifest_version": 3,
  "name": "YouTube → транскрипция",
  "version": "1.3.2",
  "description": "Скачивает субтитры YouTube-видео в txt/srt/vtt/json и озвучивает вставленный перевод голосом TeraTTS поверх видео.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Транскрипция и озвучка — открыть панель на странице YouTube",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "time-stretch.js",
        "dub.js",
        "panel.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "format.js",
        "cues.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-transcript@yt-skach.local",
      "strict_min_version": "142.0",
      "update_url": "https://github.com/chadgpttop666/youtube-transcript/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
